<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dloizides.Testing.Report</RootNamespace>
    <PackageId>Dloizides.Testing.Report</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>test-report</ToolCommandName>
    <RollForward>Major</RollForward>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>testing;trx;test-report;html;dotnet-tool;method-under-test</PackageTags>
    <Description>dotnet tool test-report: turns the .trx files of a test run into a static HTML report (problems first, feature and method grouping, [MethodUnderTest] descriptions, search, light/dark) plus a runs index and latest.html.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\report.css" LogicalName="report.css" />
    <EmbeddedResource Include="Assets\report.js" LogicalName="report.js" />
    <EmbeddedResource Include="..\..\schema\testdoc-results.v1.schema.json" LogicalName="testdoc-results.v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Dloizides.Testing\FeatureArea.cs" Link="FeatureArea.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dloizides.Testing.Report.Tests" />
    <InternalsVisibleTo Include="Dloizides.Testing.Tests" />
  </ItemGroup>

</Project>
