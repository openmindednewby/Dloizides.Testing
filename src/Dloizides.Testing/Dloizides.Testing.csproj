<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Dloizides.Testing</RootNamespace>
    <PackageId>Dloizides.Testing</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>testing;xunit;test-report;method-under-test;saas</PackageTags>
    <Description>A [MethodUnderTest] attribute plus a two-line guard that fails the build when a test-name prefix has no business description. No package dependencies.</Description>
  </PropertyGroup>

</Project>
